{
  "name": "autojob",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "面向异构企业 ATS 的语义驱动校园招聘自动投递系统",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "autojob": "tsx apps/cli/src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm privacy:check",
    "mock:serve": "tsx tests/fixtures/serve.ts",
    "test:e2e": "playwright test",
    "privacy:check": "node scripts/privacy-check.mjs",
    "worker": "tsx apps/worker/src/main.ts",
    "desktop:dev": "pnpm --dir apps/desktop tauri dev",
    "desktop:build": "pnpm --dir apps/desktop tauri build",
    "build:worker": "node scripts/build-worker.mjs",
    "build:worker:win": "node scripts/build-worker.mjs --target win-x64",
    "// build:win": "在 Linux 上交叉构建 Windows 安装包。环境准备见 docs/06-使用手册/打包.md",
    "build:win": "pnpm build:worker:win && pnpm --dir apps/desktop exec tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --bundles nsis"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "playwright": "^1.63.0",
    "postject": "1.0.0-alpha.6",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2"
  }
}
